<view class="page"><view class="header"><text class="title">{{title}}</text><text class="subtitle">输入要删除的页码，例如 2,4-6。</text></view><button class="pick" bindtap="chooseFiles">选择文件</button><view class="files" wx:if="{{files.length}}"><block wx:for="{{files}}" wx:key="path"><view class="file"><text class="file-name">{{item.name}}</text><text class="file-size">{{item.size}} bytes</text></view></block></view><view class="option"><text>删除页码</text><input value="{{options.pages}}" data-key="pages" bindinput="updateOption" /></view><button class="run" loading="{{loading}}" disabled="{{loading || !files.length}}" bindtap="runTask">开始处理</button><view class="progress" wx:if="{{loading || progress}}"><view class="bar"><view class="bar-inner" style="width: {{progress}}%;"></view></view><text class="progress-text">{{progress}}%</text></view><view class="result" wx:if="{{result}}"><text class="result-title">处理完成</text><text class="result-message">{{result.message}}</text><button class="export" bindtap="exportResult">打开或导出</button></view><text class="error" wx:if="{{error}}">{{error}}</text></view>
