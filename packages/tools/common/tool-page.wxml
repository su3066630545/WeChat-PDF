<view class="page">
  <view class="header">
    <text class="title">{{title}}</text>
    <text class="subtitle">选择文件后开始处理。大文件会自动走分片上传和后端兜底。</text>
  </view>

  <button class="pick" bindtap="chooseFiles">选择文件</button>

  <view class="files" wx:if="{{files.length}}">
    <block wx:for="{{files}}" wx:key="path">
      <view class="file">
        <text class="file-name">{{item.name}}</text>
        <text class="file-size">{{item.size}} bytes</text>
      </view>
    </block>
  </view>

  <slot></slot>

  <button class="run" loading="{{loading}}" disabled="{{loading || !files.length}}" bindtap="runTask">开始处理</button>

  <view class="skeleton" wx:if="{{showSkeleton && loading}}">
    <view class="skeleton-line skeleton-title"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line skeleton-short"></view>
    <view class="skeleton-card">
      <view class="skeleton-thumb"></view>
      <view class="skeleton-copy">
        <view class="skeleton-line"></view>
        <view class="skeleton-line skeleton-short"></view>
      </view>
    </view>
  </view>

  <view class="progress" wx:if="{{loading || progress}}">
    <view class="bar">
      <view class="bar-inner" style="width: {{progress}}%;"></view>
    </view>
    <text class="progress-text">{{progress}}%</text>
  </view>

  <view class="result" wx:if="{{result}}">
    <text class="result-title">处理完成</text>
    <text class="result-message">{{result.message}}</text>
    <button class="export" bindtap="exportResult">打开或导出</button>
  </view>

  <text class="error" wx:if="{{error}}">{{error}}</text>
</view>
