.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background: #f4f6f8;
}

.header {
  padding: 8rpx 0 24rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #69717d;
  font-size: 26rpx;
  line-height: 1.55;
}

.pipeline {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0 24rpx;
}

.step {
  flex: 1;
  height: 48rpx;
  border-radius: 8rpx;
  background: #e8ecf2;
  color: #69717d;
  font-size: 20rpx;
  line-height: 48rpx;
  text-align: center;
}

.step-active {
  background: #111827;
  color: #ffffff;
}

.pick,
.run,
.export,
.secondary {
  border-radius: 8rpx;
}

.pick {
  background: #ffffff;
  color: #1f2329;
}

.run {
  margin-top: 28rpx;
  background: #07c160;
  color: #ffffff;
}

.files,
.option,
.result {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #e3e6eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.file {
  margin-bottom: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.file:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.file-name,
.file-size,
.result-title,
.result-message,
.result-path,
.error,
.progress-text,
.option text {
  display: block;
}

.file-name {
  font-size: 28rpx;
  font-weight: 700;
  word-break: break-all;
}

.file-size {
  margin-top: 8rpx;
  color: #69717d;
  font-size: 24rpx;
}

.option text {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.option input {
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e3e6eb;
  border-radius: 8rpx;
}

.progress {
  margin-top: 24rpx;
}

.skeleton {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e3e6eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.skeleton-line,
.skeleton-thumb {
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
  background: #edf0f4;
}

.skeleton-line::after,
.skeleton-thumb::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: -45%;
  width: 45%;
  background: linear-gradient(90deg, rgba(237, 240, 244, 0), rgba(255, 255, 255, 0.82), rgba(237, 240, 244, 0));
  animation: skeleton-shimmer 1.2s ease-in-out infinite;
}

.skeleton-line {
  height: 24rpx;
  margin-top: 16rpx;
}

.skeleton-title {
  width: 44%;
  height: 32rpx;
  margin-top: 0;
}

.skeleton-short {
  width: 62%;
}

.skeleton-card {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.skeleton-thumb {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 108rpx;
}

.skeleton-copy {
  flex: 1;
  padding-top: 2rpx;
}

@keyframes skeleton-shimmer {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(320%);
  }
}

.bar {
  height: 14rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e3e6eb;
}

.bar-inner {
  height: 100%;
  background: #111827;
}

.progress-text {
  margin-top: 10rpx;
  color: #69717d;
  font-size: 24rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
}

.result-message,
.result-path {
  margin-top: 10rpx;
  color: #69717d;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.export {
  background: #111827;
  color: #ffffff;
}

.secondary {
  background: #ffffff;
  color: #1f2329;
  border: 1rpx solid #d8dde6;
}

.error {
  margin-top: 22rpx;
  color: #d93026;
  font-size: 26rpx;
}
