<view class="page">
  <view class="header">
    <text class="title">{{title}}</text>
    <text class="subtitle">选择图片并合成为 PDF。</text>
  </view>

  <button class="pick" bindtap="chooseFiles">选择图片</button>

  <view class="files" wx:if="{{files.length}}">
    <block wx:for="{{files}}" wx:key="path">
      <view class="file">
        <text class="file-name">{{item.name}}</text>
        <text class="file-size">{{item.size}} bytes</text>
      </view>
    </block>
  </view>

  <view class="option">
    <text>页面尺寸</text>
    <input value="{{options.pageSize}}" data-key="pageSize" bindinput="updateOption" />
  </view>

  <button class="run" loading="{{loading}}" disabled="{{loading || !files.length}}" bindtap="runTask">开始处理</button>

  <view class="progress" wx:if="{{loading || progress}}">
    <view class="bar">
      <view class="bar-inner" style="width: {{progress}}%;"></view>
    </view>
    <text class="progress-text">{{progress}}%</text>
  </view>

  <view class="result" wx:if="{{result}}">
    <text class="result-title">处理完成</text>
    <text class="result-message">{{result.message}}</text>
    <text class="result-path" wx:if="{{result.name}}">文件名：{{result.name}}</text>
    <text class="result-path" wx:if="{{!savedPath}}">结果文件已生成，当前为临时文件。请点“打开 PDF”查看，或点“保存到本地”持久保存。</text>
    <text class="result-path" wx:if="{{savedPath}}">已保存：{{savedPath}}</text>
    <view class="actions">
      <button class="export" bindtap="openResult">打开 PDF</button>
      <button class="secondary" bindtap="saveResult">保存到本地</button>
      <button class="secondary" bindtap="copyResultUrl">复制下载链接</button>
    </view>
  </view>

  <text class="error" wx:if="{{error}}">{{error}}</text>
</view>
