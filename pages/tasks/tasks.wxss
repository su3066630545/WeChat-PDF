.page { min-height: 100vh; padding: 36rpx 28rpx; }
.title { display: block; margin-bottom: 24rpx; font-size: 42rpx; font-weight: 800; }
.empty { padding: 32rpx; border-radius: 8rpx; background: #fff; color: #69717d; }
.task { margin-bottom: 18rpx; padding: 24rpx; border-radius: 8rpx; background: #fff; }
.name, .status, .error { display: block; }
.name { font-size: 30rpx; font-weight: 700; }
.status { margin-top: 8rpx; color: #69717d; font-size: 24rpx; }
.bar { height: 12rpx; margin-top: 16rpx; overflow: hidden; border-radius: 8rpx; background: #e3e6eb; }
.bar-inner { height: 100%; background: #2b5aed; }
.error { margin-top: 12rpx; color: #d93026; font-size: 24rpx; }
