.page {
  min-height: 100vh;
  padding: 46rpx 28rpx 44rpx;
  background: #f4f6f8;
}

.top {
  padding: 10rpx 0 34rpx;
}

.title {
  display: block;
  color: #111827;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #5f6875;
  font-size: 28rpx;
  line-height: 1.5;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 172rpx;
  padding: 18rpx 12rpx;
  border: 1rpx solid #e1e6ee;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(17, 24, 39, 0.05);
}

.tool-card:active {
  background: #eef2f7;
}

.tool-name {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.32;
  text-align: center;
}

.footer {
  display: block;
  margin-top: 42rpx;
  color: #7a8491;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
}
