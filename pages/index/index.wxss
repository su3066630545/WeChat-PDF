.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.hero {
  padding: 28rpx 0 18rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #69717d;
  font-size: 28rpx;
  line-height: 1.55;
}

.section {
  margin-top: 34rpx;
}

.section-first {
  margin-top: 0;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.tool {
  min-height: 156rpx;
  padding: 24rpx;
  border: 1rpx solid #e3e6eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.tool-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.tool-desc {
  display: block;
  margin-top: 14rpx;
  color: #69717d;
  font-size: 24rpx;
  line-height: 1.45;
}

.latest,
.queue {
  margin-top: 40rpx;
  border-radius: 8rpx;
}

.latest {
  background: #2b5aed;
  color: #ffffff;
}

.queue {
  background: #1f2329;
  color: #ffffff;
}

.feature-swiper {
  flex: 1;
  min-height: 0;
  margin-top: 34rpx;
}

.feature-page {
  height: 100%;
  box-sizing: border-box;
  padding-bottom: 72rpx;
}
