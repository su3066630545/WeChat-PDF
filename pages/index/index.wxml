<view class="page">
  <view class="top">
    <text class="title">PDF 全能工具</text>
    <text class="subtitle">本地处理、不上传、保护隐私</text>
  </view>

  <view class="grid">
    <block wx:for="{{tools}}" wx:key="key">
      <view class="tool-card" bindtap="openTool" data-path="{{item.path}}">
        <text class="tool-name">{{item.name}}</text>
      </view>
    </block>
  </view>

  <text class="footer">极速本地处理・无服务器留存</text>
</view>
