<view class="page">
  <view class="hero">
    <text class="title">PDF 工具箱</text>
    <text class="subtitle">本地优先处理 PDF，复杂或大文件自动切换到后端兜底。</text>
  </view>

  <button class="latest" wx:if="{{hasLatestResult}}" bindtap="openRecentResults">查看最近结果</button>

  <swiper class="feature-swiper" indicator-dots="{{true}}" indicator-color="#d5dbe4" indicator-active-color="#111827">
    <swiper-item>
      <scroll-view class="feature-page" scroll-y="{{true}}">
        <view class="section section-first">
          <text class="section-title">基础功能</text>
          <view class="grid">
            <block wx:for="{{primaryTools}}" wx:key="key">
              <view class="tool" bindtap="openTool" data-path="{{item.path}}">
                <text class="tool-name">{{item.name}}</text>
                <text class="tool-desc">{{item.desc}}</text>
              </view>
            </block>
          </view>
        </view>

        <view class="section">
          <text class="section-title">拓展功能</text>
          <view class="grid">
            <block wx:for="{{extraTools}}" wx:key="key">
              <view class="tool" bindtap="openTool" data-path="{{item.path}}">
                <text class="tool-name">{{item.name}}</text>
                <text class="tool-desc">{{item.desc}}</text>
              </view>
            </block>
          </view>
        </view>

        <button class="queue" bindtap="openTasks">查看任务队列</button>
      </scroll-view>
    </swiper-item>

    <swiper-item>
      <scroll-view class="feature-page" scroll-y="{{true}}">
        <view class="section section-first">
          <text class="section-title">各类文件转 PDF</text>
          <view class="grid">
            <block wx:for="{{fileToPdfTools}}" wx:key="key">
              <view class="tool" bindtap="openConversionTool" data-path="{{item.path}}" data-name="{{item.name}}">
                <text class="tool-name">{{item.name}}</text>
                <text class="tool-desc">{{item.desc}}</text>
              </view>
            </block>
          </view>
        </view>
      </scroll-view>
    </swiper-item>

    <swiper-item>
      <scroll-view class="feature-page" scroll-y="{{true}}">
        <view class="section section-first">
          <text class="section-title">PDF 导出为其他格式</text>
          <view class="grid">
            <block wx:for="{{pdfExportTools}}" wx:key="key">
              <view class="tool" bindtap="openConversionTool" data-path="{{item.path}}" data-name="{{item.name}}">
                <text class="tool-name">{{item.name}}</text>
                <text class="tool-desc">{{item.desc}}</text>
              </view>
            </block>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
