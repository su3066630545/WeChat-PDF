<view class="page">
  <view class="hero">
    <text class="title">PDF 工具箱</text>
    <text class="subtitle">本地优先处理 PDF，复杂或大文件自动切换到后端兜底。</text>
  </view>

  <view class="recent" wx:if="{{hasLatestResult}}">
    <view class="recent-head">
      <text class="section-title">查看最近结果</text>
      <text class="recent-more" bindtap="openLatestResult">最近一项</text>
    </view>
    <view class="recent-card">
      <block wx:for="{{recentResults}}" wx:key="name">
        <view class="recent-item" bindtap="openRecentResult" data-index="{{index}}">
          <text class="recent-badge {{item.badgeClass}}">{{item.badge}}</text>
          <view class="recent-info">
            <text class="recent-name">{{item.name}}</text>
            <text class="recent-meta">{{item.meta}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <text class="section-title">基础功能</text>
    <view class="grid">
      <block wx:for="{{primaryTools}}" wx:key="key">
        <view class="tool" bindtap="openTool" data-path="{{item.path}}">
          <text class="tool-name">{{item.name}}</text>
          <text class="tool-desc">{{item.desc}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <text class="section-title">拓展功能</text>
    <view class="grid">
      <block wx:for="{{extraTools}}" wx:key="key">
        <view class="tool" bindtap="openTool" data-path="{{item.path}}">
          <text class="tool-name">{{item.name}}</text>
          <text class="tool-desc">{{item.desc}}</text>
        </view>
      </block>
    </view>
  </view>

  <button class="queue" bindtap="openTasks">查看任务队列</button>
</view>
