<view class="page">
  <view class="header">
    <text class="title">最近结果</text>
    <text class="subtitle">查看刚生成和最近处理过的 PDF 文件。</text>
  </view>

  <view class="empty" wx:if="{{!results.length}}">
    <text>暂无最近结果</text>
  </view>

  <view class="list" wx:else>
    <block wx:for="{{results}}" wx:key="name">
      <view class="item" bindtap="openResult" data-index="{{index}}">
        <text class="badge {{item.badgeClass}}">{{item.badge}}</text>
        <view class="content">
          <text class="name">{{item.name}}</text>
          <text class="meta">{{item.typeName}} · {{item.time}}</text>
          <text class="message">{{item.message}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </block>
  </view>
</view>
