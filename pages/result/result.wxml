<view class="page">
  <view class="header">
    <text class="title">处理完成</text>
    <text class="subtitle">结果文件已生成。PDF 文件请先打开，再使用右上角菜单保存或转发；也可以复制下载链接。</text>
  </view>

  <view class="result" wx:if="{{result}}">
    <text class="result-title">{{result.name || 'PDF 结果文件'}}</text>
    <text class="result-message">{{result.message}}</text>
    <text class="result-path">临时路径：{{result.filePath}}</text>

    <button class="primary" bindtap="openResult">打开文件</button>
    <button class="secondary" bindtap="saveResult">{{result.kind === 'image' ? '保存到相册' : '打开并保存/转发'}}</button>
    <button class="secondary" bindtap="copyResultUrl">复制下载链接</button>
  </view>

  <view class="result" wx:else>
    <text class="result-title">暂无结果</text>
    <text class="result-message">请先返回工具页处理文件。</text>
  </view>

  <text class="error" wx:if="{{error}}">{{error}}</text>
</view>
